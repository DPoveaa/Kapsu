{
  "name": "kapsu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run sitemap && tsc && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "update": "git pull && npm install && npm run build",
    "test:kaia-contract": "node scripts/kaia-message-payload-contract-check.mjs",
    "test:kaia-contract:live": "node scripts/kaia-v2-contract-check.mjs && node scripts/kaia-message-payload-contract-check.mjs",
    "test:kaia-flows": "node scripts/kaia-v2-flow-check.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:product-pdf-export": "node scripts/product-pdf-export-check.mjs",
    "test:kaia-local": "node scripts/kaia-local-structure-check.mjs",
    "test:kaia-mode": "node scripts/kaia-conversation-mode-check.mjs",
    "test:kaia-critical": "node scripts/kaia-v2-critical-contract-check.mjs",
    "test:checkout-flow": "node scripts/checkout-flow-check.mjs",
    "test:memory-setting-frontend": "node scripts/memory-setting-frontend-check.mjs"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
