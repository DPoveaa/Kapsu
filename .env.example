# Porta do servidor de desenvolvimento
VITE_PORT=5173

# URL da API (quando conectar com backend)
VITE_API_URL=http://localhost:3000/api

# Ative somente quando a API com geração de variantes estiver publicada
VITE_IMAGE_VARIANTS_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Optional API used only by the sitemap generator.
# If omitted, production https://kapsu.com.br/api is used.
SITEMAP_API_URL=
